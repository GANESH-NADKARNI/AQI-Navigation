# ── Copy this file to .env and fill in your keys ──────────────────

# WAQI token — FREE at: https://aqicn.org/data-platform/token/
# The "demo" token works for testing but is heavily rate-limited.
WAQI_TOKEN=demo

# OpenWeatherMap — FREE: https://openweathermap.org/api (1000 calls/day)
# Used as fallback if WAQI has no data for a location.
OWM_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
